# ===================================================
# ApexTrack Sales & Inventory Management System
# Environment Configuration Template
# ===================================================

# Application
PROJECT_NAME="Sales & Inventory Management System"
API_V1_PREFIX=/api
JWT_SECRET=super-secret-sales-inventory-jwt-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# For MySQL:
DATABASE_URL=mysql+pymysql://app_user:app_password@localhost:3306/sales_inventory
# For Local Zero-Config Demo (SQLite):
# DATABASE_URL=sqlite:///./sales_inventory.db

# Configurable Manager Approval Threshold (INR ₹)
DEFAULT_APPROVAL_THRESHOLD=10000.00

# Email / MailHog Configuration
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=system@salesinventory.demo
SMTP_ENABLED=True

